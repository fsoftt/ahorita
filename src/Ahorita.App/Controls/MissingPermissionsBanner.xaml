<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:Ahorita.App.Features.Shared"
             xmlns:strings="clr-namespace:Ahorita.App.Resources.Strings"
             x:Class="Ahorita.App.Controls.MissingPermissionsBanner"
             x:DataType="shared:MissingPermissionsModel"
             IsVisible="{Binding IsVisible}">

  <!-- Aviso amable: los recordatorios no sonarán hasta activar el permiso. Sin rojo ni alarma. -->
  <Border Style="{StaticResource BentoCard}"
          Stroke="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
          StrokeThickness="1.5"
          SemanticProperties.Description="{x:Static strings:AppResources.MissingPermissions_Title}">
    <VerticalStackLayout Spacing="10">
      <Label Text="{x:Static strings:AppResources.MissingPermissions_Title}" Style="{StaticResource TextHeadline}" FontSize="18" />
      <Label Text="{x:Static strings:AppResources.MissingPermissions_Body}" Style="{StaticResource TextSecondary}" FontSize="{StaticResource SizeBody}" />
      <Label Text="{x:Static strings:AppResources.MissingPermissions_Notifications}"
             Style="{StaticResource TextSecondary}"
             IsVisible="{Binding NotificationsMissing}" />
      <Label Text="{x:Static strings:AppResources.MissingPermissions_ExactAlarms}"
             Style="{StaticResource TextSecondary}"
             IsVisible="{Binding ExactAlarmsMissing}" />
      <Button Text="{x:Static strings:AppResources.MissingPermissions_OpenNotifications}"
              Style="{StaticResource SecondaryButton}"
              IsVisible="{Binding NotificationsMissing}"
              Command="{Binding OpenNotificationSettingsCommand}" />
      <Button Text="{x:Static strings:AppResources.MissingPermissions_OpenExactAlarms}"
              Style="{StaticResource SecondaryButton}"
              IsVisible="{Binding ExactAlarmsMissing}"
              Command="{Binding OpenExactAlarmSettingsCommand}" />
    </VerticalStackLayout>
  </Border>
</ContentView>
