<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <OutputType>Exe</OutputType>
    <RootNamespace>Ahorita.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- XAML generado en compilación: arranque más rápido y errores de binding en build. -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>Ahorita</ApplicationTitle>
    <ApplicationId>com.fsoftt.ahorita</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Textos base en español; el inglés va en un ensamblado satélite. -->
    <NeutralLanguage>es</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Llave de depuración versionada (la misma que usa PiccoloReader) en lugar de la
         que cada máquina o runner de CI genera al azar: así un APK de CI se instala
         encima de uno compilado en local sin el error de firma distinta.
         Solo para sideload/QA; Google Play usa otra llave que nunca se versiona. -->
    <!-- Id de la app en AdMob (los bloques de anuncios están en Services/AdMobIds.cs). -->
    <AdMobAppId>ca-app-pub-5615495156288390~8054286154</AdMobAppId>
    <AndroidManifestPlaceholders>admobAppId=$(AdMobAppId)</AndroidManifestPlaceholders>

    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>debug.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
    <AndroidSigningStorePass>android</AndroidSigningStorePass>
  </PropertyGroup>

  <!-- Build de prueba (dotnet build -c Release -p:AhoritaTestAds=true): mismo APK pero con
       anuncios de prueba de Google, para QA y CI sin impresiones ni clics reales. -->
  <PropertyGroup Condition="'$(AhoritaTestAds)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_ADS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <!-- EF Core todavía no es 100 % seguro con trimming: se conserva completo. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6D4AFF" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#6D4AFF" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\tab_*.svg" BaseSize="24,24" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings\AppResources.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)AppResources.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Ahorita.App.Resources.Strings</StronglyTypedNamespace>
      <StronglyTypedClassName>AppResources</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ahorita.Application\Ahorita.Application.csproj" />
    <ProjectReference Include="..\Ahorita.Infrastructure\Ahorita.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Plugin.AdMob" />
  </ItemGroup>

  <ItemGroup Label="AndroidX alineado (ver Directory.Packages.props)">
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Ahorita.Infrastructure" />
    <TrimmerRootAssembly Include="Ahorita.Domain" />
  </ItemGroup>

</Project>
