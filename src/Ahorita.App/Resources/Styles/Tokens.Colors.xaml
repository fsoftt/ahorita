<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Paleta base de Ahorita. Los colores de cada rutina (acentos) viven en
  Theming/AccentPalette.cs porque se eligen en tiempo de ejecución.
  Regla: nada de colores literales en las vistas; siempre estos tokens.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Marca -->
  <Color x:Key="BrandLight">#6D4AFF</Color>
  <Color x:Key="BrandDark">#A08CFF</Color>
  <Color x:Key="OnBrand">#FFFFFF</Color>

  <!-- Superficies: claro (crema cálida) -->
  <Color x:Key="PageBackgroundLight">#FFF8F1</Color>
  <Color x:Key="SurfaceLight">#FFFFFF</Color>
  <Color x:Key="SurfaceMutedLight">#F5ECE3</Color>
  <Color x:Key="OutlineLight">#EADFD4</Color>
  <Color x:Key="InkLight">#1A1033</Color>
  <Color x:Key="InkSecondaryLight">#5B5570</Color>

  <!-- Superficies: oscuro (azul noche, no negro puro) -->
  <Color x:Key="PageBackgroundDark">#0F1020</Color>
  <Color x:Key="SurfaceDark">#1B1C33</Color>
  <Color x:Key="SurfaceMutedDark">#26274A</Color>
  <Color x:Key="OutlineDark">#30315A</Color>
  <Color x:Key="InkDark">#F4F1FF</Color>
  <Color x:Key="InkSecondaryDark">#B3B0CF</Color>

  <!-- Texto sobre acentos: siempre tinta oscura (contraste AA sobre todos los acentos). -->
  <Color x:Key="OnAccent">#1A1033</Color>
  <Color x:Key="OnAccentSecondary">#3D3355</Color>

  <!-- Sombras -->
  <Color x:Key="ShadowLight">#5A3E2B</Color>
  <Color x:Key="ShadowDark">#000000</Color>
</ResourceDictionary>
