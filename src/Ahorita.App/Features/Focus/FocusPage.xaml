<?xml version="1.0" encoding="utf-8" ?>
<common:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:common="clr-namespace:Ahorita.App.Common"
                xmlns:controls="clr-namespace:Ahorita.App.Controls"
                xmlns:focus="clr-namespace:Ahorita.App.Features.Focus"
                xmlns:strings="clr-namespace:Ahorita.App.Resources.Strings"
                x:Class="Ahorita.App.Features.Focus.FocusPage"
                x:DataType="focus:FocusViewModel"
                Title="{Binding RoutineName}">

  <!-- Llamativa en los bordes, calmada en el centro: un paso, un anillo, un botón. -->
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Tinte suave del color de la rutina sobre el fondo de la página -->
    <BoxView Grid.RowSpan="3"
             Opacity="0.28"
             Background="{Binding Accent, Converter={StaticResource AccentToGradient}}" />

    <!-- Barra superior -->
    <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Button Text="✕"
              Style="{StaticResource IconButton}"
              CornerRadius="24"
              Command="{Binding CloseCommand}"
              SemanticProperties.Description="{x:Static strings:AppResources.Focus_Close}" />
      <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
        <Label Text="{Binding RoutineName}" FontFamily="{StaticResource FontTitle}" FontSize="17" LineBreakMode="TailTruncation" />
        <Label Text="{Binding PositionText}" Style="{StaticResource TextSecondary}" />
      </VerticalStackLayout>
      <Button Grid.Column="2"
              Text="{x:Static strings:AppResources.Focus_End}"
              Style="{StaticResource TextButton}"
              FontSize="{StaticResource SizeLabel}"
              Command="{Binding EndCommand}" />
    </Grid>

    <!-- Paso actual -->
    <VerticalStackLayout x:Name="StepContent"
                         Grid.Row="1"
                         VerticalOptions="Center"
                         Spacing="{StaticResource SpaceLg}"
                         Padding="24,0"
                         IsVisible="{Binding IsReady}">
      <Grid WidthRequest="270" HeightRequest="270" HorizontalOptions="Center">
        <controls:VisualTimerView x:Name="Timer"
                                  Fraction="{Binding RemainingFraction}"
                                  StartColor="{Binding Accent, Converter={StaticResource AccentToColor}, ConverterParameter=Start}"
                                  EndColor="{Binding Accent, Converter={StaticResource AccentToColor}}"
                                  TrackColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                  AutomationProperties.IsInAccessibleTree="False" />
        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
          <Label x:Name="StepEmojiLabel" Text="{Binding StepEmoji}" Style="{StaticResource TextEmoji}" FontSize="76" />
          <Label Text="{Binding TimeText}"
                 HorizontalTextAlignment="Center"
                 FontFamily="{StaticResource FontTitle}"
                 FontSize="26"
                 FontAutoScalingEnabled="False"
                 SemanticProperties.Description="{Binding TimeText}" />
        </VerticalStackLayout>
      </Grid>

      <Label Text="{Binding StepTitle}"
             Style="{StaticResource TextDisplay}"
             FontSize="32"
             HorizontalTextAlignment="Center" />

      <Border StrokeThickness="0"
              StrokeShape="RoundRectangle 999"
              Padding="14,6"
              HorizontalOptions="Center"
              IsVisible="{Binding IsOptionalStep}"
              BackgroundColor="{Binding Accent, Converter={StaticResource AccentToColor}, ConverterParameter=Soft}">
        <Label Text="{x:Static strings:AppResources.Focus_OptionalTag}" FontFamily="{StaticResource FontBodySemiBold}" FontSize="{StaticResource SizeLabel}" />
      </Border>
    </VerticalStackLayout>

    <!-- Acciones -->
    <VerticalStackLayout Grid.Row="2" Padding="20,0,20,24" Spacing="12" IsVisible="{Binding IsReady}">
      <controls:BigActionButton Text="{x:Static strings:AppResources.Focus_Done}"
                                HeightRequest="76"
                                FontSize="22"
                                CornerRadius="38"
                                FontFamily="{StaticResource FontBodySemiBold}"
                                TextColor="{StaticResource OnAccent}"
                                Background="{Binding Accent, Converter={StaticResource AccentToGradient}}"
                                Command="{Binding DoneCommand}" />

      <Grid ColumnDefinitions="*,*,*">
        <Button Text="{x:Static strings:AppResources.Focus_Skip}" Style="{StaticResource TextButton}" Command="{Binding SkipCommand}" />
        <Button Grid.Column="1"
                Text="{x:Static strings:AppResources.Focus_Later}"
                Style="{StaticResource TextButton}"
                IsEnabled="{Binding CanPostpone}"
                Command="{Binding PostponeCommand}" />
        <Button Grid.Column="2" Text="{Binding PauseLabel}" Style="{StaticResource TextButton}" Command="{Binding TogglePauseCommand}" />
      </Grid>

      <Border Style="{StaticResource BentoCard}" Padding="16,12">
        <VerticalStackLayout Spacing="2">
          <Label Text="{Binding NextText}" FontFamily="{StaticResource FontBodySemiBold}" LineBreakMode="TailTruncation" />
          <Label Text="{Binding EstimatedEndText}" Style="{StaticResource TextSecondary}" />
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>

    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsReady, Converter={StaticResource InvertedBool}}" />
  </Grid>
</common:AppPage>
