<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ahorita.Application\Ahorita.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- WithCulture=false: el sufijo .es/.en es parte del nombre, no un ensamblado satélite. -->
    <EmbeddedResource Include="Templates\*.json" LogicalName="Ahorita.Templates.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ahorita.Infrastructure.Tests" />
  </ItemGroup>

</Project>
